# Copy to .env (gitignored). Development works without any of these.

# --- Production only ---
# Super admin created by `bin/rails db:seed` in production (no default passwords are ever created there)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# Public host used in email links, e.g. app.example.com
APP_HOST=

# Sender address for Devise emails (password reset, unlock)
MAILER_FROM=no-reply@example.com

# Database (production; development uses the local Postgres socket)
# DATABASE_URL=postgres://user:password@host:5432/restaurants_production

# Rails credentials key (or keep config/master.key out of git and pass this)
# RAILS_MASTER_KEY=
