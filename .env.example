# Copy to .env (gitignored). Development works without any of these.

# --- Production (required) ---
# JWT signing key. Generate with: openssl rand -hex 64 (development falls back to secret_key_base)
DEVISE_JWT_SECRET_KEY=
# Where the Next.js frontend runs: CORS origin and links in emails (development: http://localhost:3000)
FRONTEND_URL=
# Public host used in email links, e.g. app.example.com
APP_HOST=
# Super admin created by `bin/rails db:seed` in production (no default passwords are ever created there)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# --- Production (optional) ---
# Sender address for Devise emails (password reset)
MAILER_FROM=no-reply@example.com
# Database (development uses the local Postgres socket)
# DATABASE_URL=postgres://user:password@host:5432/restaurants_production
# Rails credentials key (or keep config/master.key out of git and pass this)
# RAILS_MASTER_KEY=

# --- Error monitoring (leave empty to disable) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Development ---
# Password for all demo accounts created by `bin/rails db:seed` (default: password123)
DEMO_PASSWORD=
