<% content_for :title, t('.sign_in') %>

<div class="mx-auto max-w-sm">
  <h1 class="page-title mb-6 text-center"><%= t('.sign_in') %></h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'card space-y-5' }) do |f| %>
    <div>
      <%= f.label :email, class: 'label' %>
      <%= f.email_field :email, autofocus: true, autocomplete: 'email', class: 'input', required: true %>
    </div>

    <div>
      <%= f.label :password, class: 'label' %>
      <%= f.password_field :password, autocomplete: 'current-password', class: 'input', required: true %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: 'checkbox' %>
        <%= f.label :remember_me, class: 'text-sm text-neutral-700' %>
      </div>
    <% end %>

    <%= f.submit t('.sign_in'), class: 'btn btn-primary w-full' %>
  <% end %>

  <%= render 'devise/shared/links' %>
</div>
