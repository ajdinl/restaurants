<% content_for :title, t('.forgot_your_password') %>

<div class="mx-auto max-w-sm">
  <h1 class="page-title mb-6 text-center"><%= t('.forgot_your_password') %></h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: 'card space-y-5' }) do |f| %>
    <%= render 'devise/shared/error_messages', resource: resource %>

    <div>
      <%= f.label :email, class: 'label' %>
      <%= f.email_field :email, autofocus: true, autocomplete: 'email', class: 'input', required: true %>
    </div>

    <%= f.submit t('.send_me_reset_password_instructions'), class: 'btn btn-primary w-full' %>
  <% end %>

  <%= render 'devise/shared/links' %>
</div>
