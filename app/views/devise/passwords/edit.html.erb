<% content_for :title, t('.change_your_password') %>

<div class="mx-auto max-w-sm">
  <h1 class="page-title mb-6 text-center"><%= t('.change_your_password') %></h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: 'card space-y-5' }) do |f| %>
    <%= render 'devise/shared/error_messages', resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div>
      <%= f.label :password, t('.new_password'), class: 'label' %>
      <%= f.password_field :password, autofocus: true, autocomplete: 'new-password', class: 'input', required: true %>
      <% if @minimum_password_length %>
        <p class="mt-1 text-xs text-neutral-500"><%= t('devise.shared.minimum_password_length', count: @minimum_password_length) %></p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, t('.confirm_new_password'), class: 'label' %>
      <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'input', required: true %>
    </div>

    <%= f.submit t('.change_my_password'), class: 'btn btn-primary w-full' %>
  <% end %>

  <%= render 'devise/shared/links' %>
</div>
