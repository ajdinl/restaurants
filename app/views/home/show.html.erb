<% content_for :title, t('.title') %>

<h1 class="page-title mb-6"><%= t('.title') %></h1>

<% if @memberships.any? %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @memberships.each do |membership| %>
      <%= link_to workspace_root_path(membership.restaurant), class: 'card block hover:border-emerald-400' do %>
        <div class="flex items-start justify-between gap-2">
          <h2 class="font-semibold"><%= membership.restaurant.name %></h2>
          <%= status_badge(membership.restaurant) %>
        </div>
        <p class="mt-1 text-sm text-neutral-500"><%= enum_label(Membership, :role, membership.role) %></p>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="card text-neutral-600"><%= t('.no_access') %></div>
<% end %>
