<% content_for :title, t('.title') %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="page-title"><%= t('.title') %></h1>
  <%= link_to t('.new'), new_admin_user_path, class: 'btn btn-primary' %>
</div>

<div class="card overflow-x-auto p-0">
  <table class="table">
    <thead>
      <tr>
        <th><%= User.human_attribute_name(:full_name) %></th>
        <th><%= User.human_attribute_name(:email) %></th>
        <th><%= User.human_attribute_name(:platform_role) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-neutral-100">
      <% @users.each do |user| %>
        <% user_policy = policy([:admin, user]) %>
        <tr>
          <td class="font-medium"><%= user.full_name %></td>
          <td><%= user.email %></td>
          <td><%= enum_label(User, :platform_role, user.platform_role) %></td>
          <td class="flex justify-end gap-4">
            <% if user_policy.update? %>
              <%= link_to t('helpers.edit'), edit_admin_user_path(user), class: 'btn-link' %>
            <% end %>
            <% if user_policy.destroy? %>
              <%= button_to t('helpers.delete'), admin_user_path(user), method: :delete, class: 'btn-link text-red-700',
                    form: { data: { turbo_confirm: t('.destroy_confirm') } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
