<%= form_with model: [:admin, restaurant], class: 'card space-y-5' do |f| %>
  <%= render 'shared/form_errors', record: restaurant %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :name, class: 'label' %>
      <%= f.text_field :name, class: 'input', required: true, autofocus: true %>
    </div>
    <div>
      <%= f.label :slug, class: 'label' %>
      <%= f.text_field :slug, class: 'input', placeholder: t('.slug_hint') %>
    </div>
    <div>
      <%= f.label :address, class: 'label' %>
      <%= f.text_field :address, class: 'input' %>
    </div>
    <div>
      <%= f.label :city, class: 'label' %>
      <%= f.text_field :city, class: 'input' %>
    </div>
    <div>
      <%= f.label :phone, class: 'label' %>
      <%= f.telephone_field :phone, class: 'input' %>
    </div>
    <div>
      <%= f.label :email, class: 'label' %>
      <%= f.email_field :email, class: 'input' %>
    </div>
    <div>
      <%= f.label :latitude, class: 'label' %>
      <%= f.number_field :latitude, step: 'any', class: 'input' %>
    </div>
    <div>
      <%= f.label :longitude, class: 'label' %>
      <%= f.number_field :longitude, step: 'any', class: 'input' %>
    </div>
    <div>
      <%= f.label :time_zone, class: 'label' %>
      <%= f.select :time_zone, Restaurant::TIME_ZONES, {}, class: 'input' %>
    </div>
    <div class="flex items-center gap-2 pt-6">
      <%= f.check_box :has_host, class: 'checkbox' %>
      <%= f.label :has_host, class: 'text-sm text-neutral-700' %>
    </div>
  </div>

  <div class="flex gap-3">
    <%= f.submit class: 'btn btn-primary' %>
    <%= link_to t('helpers.cancel'), restaurant.persisted? ? admin_restaurant_path(restaurant) : admin_restaurants_path, class: 'btn btn-secondary' %>
  </div>
<% end %>
