<% content_for :title, t('.title') %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="page-title"><%= t('.title') %></h1>
  <% if policy([:admin, Restaurant]).create? %>
    <%= link_to t('.new'), new_admin_restaurant_path, class: 'btn btn-primary' %>
  <% end %>
</div>

<div class="card overflow-x-auto p-0">
  <table class="table">
    <thead>
      <tr>
        <th><%= Restaurant.human_attribute_name(:name) %></th>
        <th><%= Restaurant.human_attribute_name(:city) %></th>
        <th><%= Restaurant.human_attribute_name(:status) %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-neutral-100">
      <% @restaurants.each do |restaurant| %>
        <tr>
          <td><%= link_to restaurant.name, admin_restaurant_path(restaurant), class: 'btn-link' %></td>
          <td><%= restaurant.city %></td>
          <td><%= status_badge(restaurant) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @restaurants.empty? %>
    <p class="px-4 py-6 text-sm text-neutral-500"><%= t('.empty') %></p>
  <% end %>
</div>
