<header class="border-b border-neutral-200 bg-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <div class="flex items-center gap-6">
      <%= link_to t('app.name'), root_path, class: 'text-lg font-semibold text-neutral-900' %>

      <% if user_signed_in? && current_user.platform_staff? %>
        <nav class="flex items-center gap-4 text-sm">
          <%= link_to t('nav.dashboard'), admin_root_path, class: 'text-neutral-600 hover:text-neutral-900' %>
          <%= link_to t('nav.restaurants'), admin_restaurants_path, class: 'text-neutral-600 hover:text-neutral-900' %>
          <%= link_to t('nav.users'), admin_users_path, class: 'text-neutral-600 hover:text-neutral-900' %>
        </nav>
      <% end %>

      <% if Current.restaurant %>
        <span class="text-sm text-neutral-500">/ <%= Current.restaurant.name %></span>
      <% end %>
    </div>

    <div class="flex items-center gap-4">
      <%= render 'shared/locale_switcher' %>

      <% if user_signed_in? %>
        <span class="hidden text-sm text-neutral-600 sm:inline"><%= current_user.full_name %></span>
        <%= button_to t('nav.sign_out'), destroy_user_session_path, method: :delete, class: 'btn-link', form_class: 'inline' %>
      <% end %>
    </div>
  </div>
</header>
